NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/smart_autocare
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# Initial administrator (required on first run — there are no demo accounts)
# Never commit the real values.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Administrator
ADMIN_PHONE=

# Optional SMTP (emails are logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart AutoCare <no-reply@smartautocare.com>
# Optional image hosting (uploads are stored locally under /uploads by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=20